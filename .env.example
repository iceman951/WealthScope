# Which database to use is decided by the shape of DATABASE_URL:
#
#   file:./.pglite     PGlite — real PostgreSQL 17 compiled to WebAssembly, running
#                      in this process. No network, no service to start, and the
#                      data survives restarts. The local development default.
#   memory://          PGlite, discarded on exit. Used by the integration tests.
#   postgresql://…     Neon. Use the POOLED connection string (the "-pooler" host),
#                      in the region closest to Thailand (ap-southeast-1, Singapore).
#                      This is what production runs on.
#
# Switching between them is this one line — nothing in the code changes, because
# PGlite and Neon are the same database with the same migrations.
DATABASE_URL=file:./.pglite

# Better Auth session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string

# Public origin of the deployment. Must match the browser origin exactly.
BETTER_AUTH_URL=http://localhost:5555

PUBLIC_APP_NAME=WealthScope
PUBLIC_DEFAULT_LOCALE=th-TH
PUBLIC_DEFAULT_CURRENCY=THB

# Database used by the integration tests. They skip themselves when this is unset.
# `memory://` runs them against a throwaway PGlite instance, no infrastructure
# needed; a postgresql:// URL points them at a real scratch database instead.
# TEST_DATABASE_URL=memory://
