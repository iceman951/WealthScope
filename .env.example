# The database is a Cloudflare D1 binding, not a connection string. It is
# declared in wrangler.jsonc (binding "DB") and needs nothing here:
#
#   pnpm dev          a local SQLite file under .wrangler/state, via the adapter's
#                     platform proxy. Run `pnpm db:migrate` once to build the schema;
#                     the first request then seeds the demo household.
#   pnpm preview      the same local database, on workerd.
#   pnpm deploy       the real D1 database (`wrangler d1 create wealthscope`, then
#                     put its id in wrangler.jsonc and run `pnpm db:migrate:remote`).
#
# Integration tests start a throwaway in-memory D1 of their own; set
# SKIP_INTEGRATION=1 to leave them out of a run.

# Better Auth session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string

# Public origin of the deployment. Must match the browser origin exactly.
BETTER_AUTH_URL=http://localhost:5555

PUBLIC_APP_NAME=WealthScope
PUBLIC_DEFAULT_LOCALE=th-TH
PUBLIC_DEFAULT_CURRENCY=THB
