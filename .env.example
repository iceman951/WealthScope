# Neon Serverless PostgreSQL — use the POOLED connection string ("-pooler" host).
# Create the project in the region closest to Thailand (ap-southeast-1, Singapore).
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/wealthscope?sslmode=require

# Better Auth session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string

# Public origin of the deployment. Must match the browser origin exactly.
BETTER_AUTH_URL=http://localhost:5173

PUBLIC_APP_NAME=WealthScope
PUBLIC_DEFAULT_LOCALE=th-TH
PUBLIC_DEFAULT_CURRENCY=THB

# Optional: separate database used by integration tests. Tests are skipped when unset.
# TEST_DATABASE_URL=
