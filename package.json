{
	"name": "wealthscope",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.20.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"prepare": "svelte-kit sync && wrangler types --include-env=false",
		"predev": "svelte-kit sync",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev",
		"deploy": "wrangler deploy",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply wealthscope --local",
		"db:migrate:remote": "wrangler d1 migrations apply wealthscope --remote",
		"db:seed": "tsx scripts/seed.ts",
		"db:reset": "node -e \"require('node:fs').rmSync('.wrangler/state',{recursive:true,force:true})\"",
		"cf:types": "wrangler types --include-env=false"
	},
	"dependencies": {
		"better-auth": "^1.7.5",
		"decimal.js": "^10.6.0",
		"drizzle-orm": "^0.45.2",
		"echarts": "^6.1.0",
		"papaparse": "^5.7.0",
		"pdf-lib": "^1.17.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.6.2",
		"@types/papaparse": "^5.5.2",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.11",
		"wrangler": "^4.135.0"
	}
}
